# Local embedded Postgres is used when DATABASE_URL is unset and NODE_ENV is not production.
DATABASE_URL=postgres://passageworks:passageworks@127.0.0.1:5432/passageworks
STORAGE_ROOT=./.data/storage
HOST=127.0.0.1
PORT=8787
COOKIE_SECURE=false
WEB_DIST=apps/web/dist

# Demo seed is off unless you set this. Do not expose a seeded server to the public internet.
SEED_DEMO=false
DEMO_EMAIL=archivist@northglass.example
DEMO_PASSWORD=replace-with-a-long-local-password

# Optional OpenAI-compatible chat provider. Generation stays unavailable until all three are set.
# Selected source passages are sent to this provider. See PRIVACY-Cursor.md.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
